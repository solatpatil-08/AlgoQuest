# ==============================================================================
# AlgoQuest - Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# For production (Vercel / Render), set these in the dashboard project settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Secret key for cryptographic signing. Generate a strong key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret

# Set to False in production. Vercel deployment automatically defaults to False.
DJANGO_DEBUG=False

# Comma-separated list of allowed host domains.
# On Vercel, .vercel.app is automatically allowed if VERCEL=1 is detected.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.vercel.app

# Comma-separated list of trusted origins for CSRF protection.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# ------------------------------------------------------------------------------
# Database Settings (REQUIRED for Vercel Production)
# Vercel functions are stateless serverless functions; SQLite cannot persist writes.
# Use a cloud PostgreSQL provider (Neon, Supabase, Vercel Postgres, etc.)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@ep-host.region.pooler.neon.tech/algoquest_db?sslmode=require

# Optional build migration flags (Vercel / Render)
RUN_MIGRATIONS_ON_BUILD=false
LOAD_CHALLENGE_BANK_ON_BUILD=false

# Alternative PostgreSQL variables (if not using DATABASE_URL):
DJANGO_USE_POSTGRES=False
POSTGRES_DB=algoquest_db
POSTGRES_USER=algoquest_user
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# ------------------------------------------------------------------------------
# Security & SSL Settings (defaults to safe settings on Vercel)
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# Email Settings (for password reset / OTP notifications)
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-email-app-password
DJANGO_EMAIL_TIMEOUT=30
DJANGO_DEFAULT_FROM_NAME=AlgoQuest
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_SITE_ID=1

# ------------------------------------------------------------------------------
# Social OAuth Providers (Optional)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
